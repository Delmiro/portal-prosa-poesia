{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "portal-prosa-poesia",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "portal-prosa-poesia"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  // Não coloque DATABASE_URL / JWT_SECRET aqui (risco + o deploy substitui `vars`).
  // Use Secrets no painel (Workers → Settings) ou: wrangler secret put DATABASE_URL
  "vars": {
    "CF_WORKER": "1"
  }
}
